{
  "name": "sih26102-mplads-intelligence-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "python -m uvicorn app.main:app --app-dir backend --reload --port 8000",
