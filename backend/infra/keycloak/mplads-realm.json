{
  "realm": "mplads",
  "enabled": true,
  "displayName": "MPLADS Intelligence",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "NationalAdmin", "description": "National platform administrator" },
      { "name": "StateOfficer", "description": "State-scoped monitoring officer" },
      { "name": "DistrictOfficer", "description": "District-scoped monitoring officer" },
      { "name": "Auditor", "description": "Read and investigation access with audit responsibilities" },
      { "name": "Viewer", "description": "Read-only dashboard access" }
    ]
  },
  "clients": [
    {
      "clientId": "mplads-dashboard",
      "name": "MPLADS Dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "protocol": "openid-connect",
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "mplads-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mplads-dashboard",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "officer-state",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "state",
            "claim.name": "state",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "officer-district",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "district",
            "claim.name": "district",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"]
    }
  ],
  "users": [
    {
      "username": "demo.admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Administrator",
      "email": "demo.admin@example.invalid",
      "credentials": [
        { "type": "password", "value": "demo-only-change-me", "temporary": true }
      ],
      "realmRoles": ["NationalAdmin", "Auditor", "Viewer"]
    }
  ]
}
