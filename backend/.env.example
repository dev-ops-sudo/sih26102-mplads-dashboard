# Local full-stack services
POSTGRES_PASSWORD=replace-for-shared-environments
MINIO_ROOT_USER=mplads
MINIO_ROOT_PASSWORD=replace-for-shared-environments
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-for-shared-environments

# Keep false for zero-setup API demo mode. Enable after Keycloak is ready.
MPLADS_AUTH_ENABLED=false

# Optional investigation provider. Without this, evidence-grounded demo responses are returned.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Direct backend development without containers
MPLADS_DATABASE_URL=sqlite:///./backend/mplads.db
MPLADS_REDIS_URL=redis://localhost:6379/0
MPLADS_CELERY_ENABLED=false
MPLADS_STORAGE_BACKEND=local
MPLADS_LOCAL_UPLOAD_DIR=work/uploads
# For S3/MinIO, use an internal service endpoint and a browser-accessible public endpoint.
MPLADS_S3_ENDPOINT_URL=http://localhost:9000
MPLADS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
